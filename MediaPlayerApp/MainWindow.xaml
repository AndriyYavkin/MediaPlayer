<Window x:Class="MediaPlayerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MediaPlayerApp.ViewModels"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Media Player"
        Height="680" Width="1020"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <Style x:Key="HeaderMenuTopItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade">
                                    <Border Background="#1E1F2A"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            Margin="0,4,0,0">
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2E303E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="HeaderRow"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource AudioDiscGeometry}"
                          Fill="{StaticResource AccentHoverBrush}"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Margin="0,0,10,0"/>
                    <TextBlock Text="Media Player"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="28,0,0,0"
                            VerticalAlignment="Center">
                    <Button Content="Open File..."
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Command="{Binding OpenFileCommand}"
                            ToolTip="Open local audio or video file (Ctrl+O)"
                            Margin="0,0,8,0"/>

                    <Button Content="Open URL..."
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Command="{Binding OpenUrlCommand}"
                            ToolTip="Stream media from a remote network link (Ctrl+U)"
                            Margin="0,0,8,0"/>

                    <Menu Background="Transparent">
                        <MenuItem Header="Sample Media ▾"
                                  Style="{StaticResource HeaderMenuTopItemStyle}"
                                  ItemsSource="{Binding SampleItems}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource SubMenuItemStyle}">
                                    <Setter Property="Header" Value="{Binding Title}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.LoadSampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconOnlyFlatButtonStyle}"
                            Command="{Binding ToggleFullscreenCommand}"
                            ToolTip="Toggle Fullscreen (F / F11)">
                        <Path Width="14" Height="14"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource FullscreenEnterGeometry}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource FullscreenExitGeometry}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#000000" ClipToBounds="True">
            <MediaElement x:Name="MediaDisplayElement"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="Uniform"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          MouseLeftButtonDown="OnMediaDisplayMouseLeftButtonDown"/>

            <Border Background="#0C0D12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="{Binding IsVideoVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Width="96" Height="96"
                            CornerRadius="48"
                            Background="#181924"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <Path Data="{StaticResource AudioDiscGeometry}"
                              Fill="{StaticResource AccentHoverBrush}"
                              Width="44" Height="44"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{Binding MediaTitleDisplay}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="520"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding MediaSubtitleDisplay}"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="520"
                               Margin="0,0,0,18"/>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Button Content="Open File"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Command="{Binding OpenFileCommand}"
                                Width="105"
                                Margin="0,0,10,0"/>
                        <Button Content="Open URL"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Command="{Binding OpenUrlCommand}"
                                Width="105"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource ControlsBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12,16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTimeDisplay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="TimelineSlider"
                            Grid.Column="1"
                            Style="{StaticResource MediaTimelineSliderStyle}"
                            Minimum="0"
                            Maximum="{Binding MaxProgressValue}"
                            Value="{Binding ProgressValue, Mode=TwoWay}"
                            IsEnabled="{Binding HasMedia}"
                            primitives:Thumb.DragStarted="OnTimelineDragStarted"
                            primitives:Thumb.DragCompleted="OnTimelineDragCompleted"
                            PreviewMouseLeftButtonUp="OnTimelinePreviewMouseLeftButtonUp"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalTimeDisplay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#20222D"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusBadgeText}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>

                        <TextBlock Text="{Binding MediaTitleDisplay}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="180"
                                   ToolTip="{Binding MediaTitleDisplay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportControlButtonStyle}"
                                Command="{Binding PlayPreviousCommand}"
                                ToolTip="Previous media / restart (Ctrl+Left)"
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource PreviousTrackGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource PrimaryPlayControlButtonStyle}"
                                Command="{Binding PlayPauseCommand}"
                                ToolTip="Play / Pause (Space)"
                                Margin="0,0,10,0">
                            <Path Width="16" Height="16"
                                  Fill="#FFFFFF"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource PlayGeometry}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource PauseGeometry}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Button Style="{StaticResource TransportControlButtonStyle}"
                                Command="{Binding StopCommand}"
                                ToolTip="Stop playback"
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource StopGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource TransportControlButtonStyle}"
                                Command="{Binding PlayNextCommand}"
                                ToolTip="Next media (Ctrl+Right)">
                            <Path Data="{StaticResource NextTrackGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconOnlyFlatButtonStyle}"
                                Command="{Binding ToggleMuteCommand}"
                                ToolTip="Mute / Unmute (M)"
                                Margin="0,0,6,0">
                            <Path Width="15" Height="15"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource VolumeHighGeometry}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource VolumeMuteGeometry}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Volume}" Value="0">
                                                <Setter Property="Data" Value="{StaticResource VolumeMuteGeometry}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource VolumeSliderStyle}"
                                Width="85"
                                Minimum="0.0"
                                Maximum="1.0"
                                Value="{Binding Volume, Mode=TwoWay}"
                                ToolTip="{Binding Volume, Converter={StaticResource VolumePercentConverter}}"
                                Margin="0,0,8,0"/>

                        <TextBlock Text="{Binding Volume, Converter={StaticResource VolumePercentConverter}}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Width="32"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Button Style="{StaticResource IconOnlyFlatButtonStyle}"
                                Command="{Binding ToggleFullscreenCommand}"
                                ToolTip="Toggle Fullscreen (F / F11)">
                            <Path Width="14" Height="14"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource FullscreenEnterGeometry}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource FullscreenExitGeometry}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
